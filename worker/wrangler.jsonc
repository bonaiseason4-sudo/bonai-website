{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bunay-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bunay",
      "database_id": "35ce0a36-7306-4ebf-96bc-6b422f3d370f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated list of frontend origins allowed to call the API. "*" allows any origin.
    "ALLOWED_ORIGINS": "*"
  }
}
